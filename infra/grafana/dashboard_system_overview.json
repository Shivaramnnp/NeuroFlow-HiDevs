{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Queries Per Minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(neuroflow_queries_total[1m])) * 60",
          "legendFormat": "Queries/min",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Retrieval Latency (p50 & p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(neuroflow_retrieval_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Retrieval Latency (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(neuroflow_retrieval_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Retrieval Latency (s)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Generation Latency (p50 & p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(neuroflow_generation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Generation Latency (s)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(neuroflow_generation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Generation Latency (s)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "LLM Cost Per Hour (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(neuroflow_llm_cost_usd_sum[1h])) * 3600",
          "legendFormat": "Cost ($/hr)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Ingestion Queue Depth",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "neuroflow_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "Active Open Circuit Breakers",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "neuroflow_circuit_breakers_open",
          "legendFormat": "Open Circuits",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["neuroflow", "rag", "resilience"],
  "time": {
    "from": "now-1h",
